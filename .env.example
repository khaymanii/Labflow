# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://labflow:labflow@localhost:5432/labflow?schema=public"

# Auth.js secret. Generate one with: npx auth secret  (or openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret"

# Trust the host when running locally or behind a proxy.
AUTH_TRUST_HOST="true"

# Optional: application name shown in the UI.
NEXT_PUBLIC_APP_NAME="LabFlow"
